{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/q/:token",
      "destination": "https://essdesign-production.up.railway.app/q/:token"
    },
    {
      "source": "/t/:tagRef",
      "destination": "https://essdesign-production.up.railway.app/t/:tagRef"
    },
    {
      "source": "/scaff-tag/:path*",
      "destination": "https://essdesign-production.up.railway.app/t/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://essdesign-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
